// Assessment Brain — database schema (foundation only).
//
// This schema models the core entities needed to move an assessment through
// its lifecycle (teacher creates assessment -> questions -> rubrics ->
// publish -> student submissions -> per-question processing -> results).
// The Assessment Brain intelligence pipeline itself (question understanding,
// rubric generation, answer reading, correction, annotation, grading) is
// NOT implemented here — pipeline outputs are represented as JSON fields to
// be filled in by future work.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------

enum Role {
  TEACHER
  STUDENT
}

/// A single User model backs both teachers and students. Authentication is
/// not implemented yet — this model only prepares for it.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  role         Role
  /// bcrypt/bcryptjs hash of the user's password. Credentials-based
  /// authentication only (Auth.js) — never store or log the plaintext value.
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // As TEACHER
  classesTaught      Class[]      @relation("ClassTeacher")
  assessmentsCreated Assessment[] @relation("AssessmentTeacher")
  reviewsPerformed   ReviewItem[] @relation("ReviewItemReviewer")

  // As STUDENT
  classMemberships ClassMembership[]
  submissions      Submission[]

  @@index([role])
}

// ---------------------------------------------------------------------------
// Class + membership
// ---------------------------------------------------------------------------

/// A class managed by one teacher. Students are linked via ClassMembership
/// rather than a direct relation, since a student may belong to many classes.
model Class {
  id        String   @id @default(cuid())
  name      String
  grade     String
  section   String?
  teacherId String
  teacher   User     @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: Restrict)

  /// Short code a student types once to enrol themselves in this class (see
  /// src/lib/classJoinCode.ts). Unique so a code identifies exactly one class.
  ///
  /// Nullable because classes created before self-enrolment existed have none;
  /// one is generated on demand the first time a teacher looks at the class,
  /// so no backfill is needed and an old class is never left unjoinable.
  joinCode String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships ClassMembership[]
  assessments Assessment[]
}

/// Join model between Class and User (students). Deliberately explicit
/// (rather than an implicit Prisma many-to-many) so membership can carry its
/// own timestamp and be extended later (e.g. joinedAt, status) without a
/// migration to a different relation shape.
model ClassMembership {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([classId, studentId])
  @@index([studentId])
}

// ---------------------------------------------------------------------------
// Assessment + Question
// ---------------------------------------------------------------------------

enum AssessmentStatus {
  DRAFT
  RUBRIC_GENERATING
  RUBRIC_REVIEW
  READY
  PUBLISHED
  PROCESSING
  RESULTS_AVAILABLE
  CLOSED
}

model Assessment {
  id         String           @id @default(cuid())
  title      String
  subject    String
  grade      String
  curriculum String
  status     AssessmentStatus @default(DRAFT)
  teacherId  String
  teacher    User             @relation("AssessmentTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  classId    String
  class      Class            @relation(fields: [classId], references: [id], onDelete: Restrict)

  /// Free-text instructions shown to students alongside the question paper
  /// (e.g. "Answer all questions. Show your working."). Nullable because
  /// most existing assessments were created before this field existed and
  /// have none; populated either by a teacher typing it directly or by
  /// approving an AI-extracted question-paper draft that found one (Phase
  /// 3.3) — see QuestionPaper below.
  instructions String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions      Question[]
  submissions    Submission[]
  reviewItems    ReviewItem[]
  questionPapers QuestionPaper[]

  @@index([status])
  @@index([classId])
}

// ---------------------------------------------------------------------------
// QuestionPaper + QuestionPaperPage (Phase 3.3 — question-paper ingestion)
// ---------------------------------------------------------------------------

enum QuestionPaperExtractionStatus {
  /// Uploaded, extraction not yet started.
  PENDING
  /// AI extraction currently running.
  PROCESSING
  /// Extraction succeeded — a draft exists and awaits teacher review.
  EXTRACTED
  /// Extraction failed; the uploaded pages are preserved and retry is offered.
  FAILED
  /// The teacher approved the draft; real Questions have been created from it.
  /// Terminal — an approved QuestionPaper is never re-extracted or re-approved.
  APPROVED
}

/// One teacher-uploaded question paper for an assessment, and the AI-assisted
/// extraction attempt made from it. Deliberately independent of Question:
/// this model only tracks ingestion of the *source document* and its
/// *draft* extraction — it never becomes the source of truth for grading.
/// Real Questions are only ever created by the explicit approval action
/// (src/app/teacher/assessments/[id]/questionPaperActions.ts), never
/// written directly from AI output.
///
/// At most one non-terminal (PENDING/PROCESSING/FAILED/EXTRACTED) draft is
/// allowed per assessment at the application layer — a teacher must delete
/// or approve the current draft before starting another — but this is not a
/// database constraint, since an assessment may legitimately accumulate
/// multiple APPROVED-then-superseded historical rows over time.
model QuestionPaper {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  extractionStatus QuestionPaperExtractionStatus @default(PENDING)

  /// The structured draft produced by AI extraction (see
  /// src/types/questionPaper.ts for its shape) — title/instructions/
  /// questions exactly as the model read them, before any teacher edit.
  /// Null until extraction completes at least once. The teacher's edits
  /// during review live only in client state until Approve; this column is
  /// never overwritten by a review edit, only by a fresh extraction attempt.
  extractedContent Json?

  /// Set when extractionStatus is FAILED — a plain-language reason shown to
  /// the teacher, never a raw stack trace or provider error body.
  extractionError String? @db.Text

  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pages QuestionPaperPage[]

  @@index([assessmentId])
}

/// One uploaded file belonging to a QuestionPaper's source document — either
/// exactly one page whose mimeType is application/pdf (the PDF itself
/// carries all of its pages internally), or one-to-many pages whose
/// mimeType is an image type (one photographed/scanned page per row),
/// mirroring AnswerSheetPage's precedent for exactly the same reason:
/// students and teachers alike may only have a phone camera, not a scanner.
model QuestionPaperPage {
  id              String        @id @default(cuid())
  questionPaperId String
  questionPaper   QuestionPaper @relation(fields: [questionPaperId], references: [id], onDelete: Cascade)

  /// 1-based position, database-enforced unique per paper (see @@unique
  /// below) — same convention as AnswerSheetPage.pageNumber.
  pageNumber Int

  /// Server-generated storage identifier into storage/question-papers/ (see
  /// src/lib/storage/questionPapers.ts) — never a public URL, never derived
  /// from the original filename.
  storageKey String @unique

  originalFilename String

  /// Sniffed from the file's actual bytes at upload time. One of
  /// application/pdf, image/jpeg, image/png, image/webp.
  mimeType String

  fileSizeBytes Int

  createdAt DateTime @default(now())

  @@unique([questionPaperId, pageNumber])
}

/// One question within an assessment. Structured, AI-extracted question data
/// (e.g. parsed sub-parts, detected question type) is intentionally deferred
/// until question understanding is implemented.
model Question {
  id             String     @id @default(cuid())
  assessmentId   String
  assessment     Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionNumber Int
  questionText   String     @db.Text
  maximumMarks   Decimal    @db.Decimal(5, 2)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  rubric      Rubric?
  responses   QuestionResponse[]
  reviewItems ReviewItem[]

  @@unique([assessmentId, questionNumber])
}

// ---------------------------------------------------------------------------
// Rubric + RubricVersion
// ---------------------------------------------------------------------------

enum RubricVersionStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
}

/// A Rubric is the logical container for one Question's rubric history. It
/// does not itself hold marking content — that lives on immutable
/// RubricVersion rows. `activeVersion` and `versions` are two distinct
/// relations to RubricVersion and must be named separately:
///   - `versions`: one-to-many, RubricVersion.rubricId -> Rubric.id
///     (every version this rubric has ever had)
///   - `activeVersion`: one-to-one, Rubric.(activeVersionId, id) ->
///     RubricVersion.(id, rubricId) — a composite FK, so the database
///     itself (not just application code) guarantees the active version
///     actually belongs to THIS rubric, not some other one. A plain
///     single-column FK to RubricVersion.id could only confirm the row
///     exists, not that its rubricId matches. With MATCH SIMPLE (Postgres's
///     default), the composite FK is skipped entirely while
///     activeVersionId is null, so "no active version yet" remains valid.
///     onDelete is Restrict (not SetNull): one of the local columns in this
///     composite FK is Rubric.id itself, which can never be null, so
///     SetNull is not a valid option here — a version currently marked
///     active must be reassigned or cleared before it can be deleted.
/// This keeps "which version is active" as an explicit, nullable pointer
/// (a rubric may have no active version yet) instead of inferring it from
/// version status, so exactly one active version can never become ambiguous.
model Rubric {
  id              String         @id @default(cuid())
  questionId      String         @unique
  question        Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  activeVersionId String?        @unique
  activeVersion   RubricVersion? @relation("ActiveRubricVersion", fields: [activeVersionId, id], references: [id, rubricId], onDelete: Restrict)

  /// Phase 4.1 — tracks the automatic AI rubric-generation attempt for this
  /// question, independent of whether an active version actually exists yet
  /// (mirrors QuestionPaper.extractionStatus / SubmissionProcessing.status's
  /// PENDING -> [GENERATING] -> terminal shape). A Rubric row is created
  /// (status PENDING) alongside its Question the moment the question exists
  /// — via approved extraction or manual add — so the teacher-facing UI can
  /// show "generating" before any version is written. A manually-saved
  /// version (saveRubricVersion, kept for backward compatibility) also sets
  /// this to READY, since a rubric a teacher wrote by hand is just as ready
  /// as one the AI wrote.
  generationStatus RubricGenerationStatus @default(PENDING)

  /// Set only when generationStatus is FAILED — a short, plain-language
  /// reason, never a raw stack trace or provider error body.
  generationError String? @db.Text

  /// Phase 4.4 — set only when generationStatus is REVIEW_REQUIRED: the
  /// structured result of the pre-generation question-validation check (see
  /// src/lib/rubricGeneration/questionValidation.ts). Distinct from
  /// generationError: this is not a technical failure, it's the AI
  /// declining to invent missing/ambiguous information rather than
  /// silently guessing — so it is never cleared by a bare retry, only by
  /// the teacher editing the question (see updateQuestion in actions.ts,
  /// which resets generationStatus back to PENDING and clears these three
  /// fields together).
  validationIssueType QuestionValidationIssueType?

  /// Short (<=200 char) plain-language label for the problem, e.g. "Missing
  /// value in the data set" — the primary thing shown next to the question.
  validationIssueSummary String? @db.Text

  /// 1-3 sentence explanation of why the question can't be reliably
  /// assessed as written. Deliberately capped short (<=1000 chars) — this
  /// is a pointer for the teacher to go fix the question, not a stored
  /// analysis document.
  validationExplanation String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions RubricVersion[] @relation("RubricVersions")

  /// Required by Prisma for the composite FK above (a one-to-one relation's
  /// defining side must have a compound-unique on its full field list).
  /// activeVersionId alone stays @unique, so "at most one Rubric may claim
  /// a given RubricVersion as active" is still separately enforced.
  @@unique([activeVersionId, id])
  @@index([generationStatus])
}

enum RubricGenerationStatus {
  /// Rubric row exists (created alongside its Question) but generation
  /// hasn't been claimed/run yet.
  PENDING
  /// AI generation is currently running for this question. Also covers the
  /// Phase 4.4 pre-generation validation check itself — both happen inside
  /// one claimed run, so the teacher-facing UI never needs to distinguish
  /// "being validated" from "being generated."
  GENERATING
  /// Generation succeeded — activeVersionId points at the result.
  READY
  /// A technical failure (AI/network error, malformed AI output) during
  /// validation or generation; the Question and any prior active version
  /// (from an earlier successful generation, if this is a retry) are
  /// preserved. Retriable — see src/lib/rubricGeneration.
  FAILED
  /// Phase 4.4 — the pre-generation validation check determined the
  /// question itself is not reliably assessable as written (missing
  /// essential information, real ambiguity, contradictory information,
  /// invalid/impossible data, a broken reference, or a visibly incomplete
  /// sub-part) — see validationIssueType/validationIssueSummary/
  /// validationExplanation below. Deliberately distinct from FAILED: this
  /// is a content problem the AI correctly declined to paper over, not a
  /// technical error, so a bare retry must never clear it — only the
  /// teacher editing the question does (see updateQuestion).
  REVIEW_REQUIRED
}

/// Phase 4.4 — why a question's pre-generation validation check flagged it.
/// A controlled, closed set rather than a free-text/"OTHER" category so the
/// teacher-facing UI can give each one a specific icon, wording, and
/// guidance rather than a generic "there's a problem" message.
enum QuestionValidationIssueType {
  /// A value, condition, table cell, or other essential input the question
  /// needs is simply absent (e.g. a blanked-out number in a data set).
  MISSING_INFORMATION
  /// Multiple reasonable readings of the question would produce a
  /// materially different expected answer or marking criteria — not merely
  /// multiple valid solution methods for the same answer.
  AMBIGUOUS_QUESTION
  /// The question's own stated facts conflict with each other (e.g. claims
  /// 10 observations but lists 8).
  CONTRADICTORY_INFORMATION
  /// The given data is mathematically or logically impossible (e.g. a
  /// probability above 1, a negative frequency).
  INVALID_DATA
  /// The question refers to a diagram, graph, table, or other artifact that
  /// isn't actually present in what was extracted.
  MISSING_REFERENCE
  /// The question (or one of its sub-parts) is visibly cut off or blank.
  INCOMPLETE_QUESTION
}

/// An immutable version of a rubric. Once created, a version's content
/// should not be edited in place — a change produces a new version instead.
/// `solutionApproaches` and `markingCheckpoints` are JSON because their
/// internal shape is AI-generated and expected to evolve; they don't yet
/// need relational querying of their own.
model RubricVersion {
  id                 String              @id @default(cuid())
  rubricId           String
  rubric             Rubric              @relation("RubricVersions", fields: [rubricId], references: [id], onDelete: Cascade)
  versionNumber      Int
  status             RubricVersionStatus @default(DRAFT)
  solutionApproaches Json?
  markingCheckpoints Json?

  /// Phase 4.1 — the correct final answer/conclusion (or, for a question
  /// with no single fixed answer, what a complete correct answer must
  /// demonstrate). Free text rather than JSON: unlike solutionApproaches and
  /// markingCheckpoints, nothing in the existing pipeline parses this as a
  /// list, so there's no array-shape contract to preserve. Teacher-facing
  /// display only in this phase — not yet read by the evaluation pipeline.
  expectedAnswer String? @db.Text

  /// Phase 4.1 — how marks should reasonably be awarded for this specific
  /// question's likely partial-credit situations (method correct but
  /// arithmetic slip, incomplete answer, missing reasoning, etc). Teacher-
  /// facing display only in this phase — not yet read by the evaluation
  /// pipeline.
  partialCreditGuidance String? @db.Text

  /// A machine-comparable view of this same rubric (see
  /// src/types/mathCorrection.ts) — per-approach named variables plus one
  /// numeric expected answer — used ONLY by the Mathematics handwritten
  /// correction flow's deterministic comparison stage. An addition to the
  /// prose rubric above, never a replacement: nothing that already reads
  /// solutionApproaches/markingCheckpoints/expectedAnswer is affected.
  ///
  /// JSON, matching the fields above, because the shape is still evolving.
  /// Null for every non-Mathematics question and for any question the
  /// generator judged to have no single checkable answer — an essay or proof
  /// has nothing to compare numerically, which is a normal outcome rather
  /// than a generation failure.
  structuredExpectation Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Reverse side of Rubric.activeVersion — present only if this version is
  /// currently the active one for its rubric.
  activeForRubric         Rubric?                  @relation("ActiveRubricVersion")
  questionResponses       QuestionResponse[]
  novelApproachCandidates NovelApproachCandidate[]

  @@unique([rubricId, versionNumber])
  /// Backs the composite FK from Rubric.activeVersion — lets a foreign key
  /// pin down a specific (id, rubricId) pair, not just id alone.
  @@unique([id, rubricId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Submission + QuestionResponse
// ---------------------------------------------------------------------------

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  PROCESSING
  COMPLETED
  NEEDS_REVIEW
  FAILED
}

/// One student's answer paper for one assessment. A unique constraint on
/// (assessmentId, studentId) enforces the current assumption of a single
/// active submission per student per assessment.
model Submission {
  id           String           @id @default(cuid())
  assessmentId String
  assessment   Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  studentId    String
  student      User             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  status       SubmissionStatus @default(DRAFT)
  submittedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  questionResponses     QuestionResponse[]
  reviewItems           ReviewItem[]
  answerSheetPages      AnswerSheetPage[]
  handwrittenProcessing SubmissionProcessing?

  @@unique([assessmentId, studentId])
  @@index([status])
}

/// One uploaded page image belonging to a student's Submission — the storage
/// foundation for the eventual handwritten-answer-sheet workflow (see
/// src/lib/answerReading's own README). Deliberately independent of
/// QuestionResponse for now: this model only persists and secures uploaded
/// pages, with no OCR, segmentation, or question-mapping yet.
///
/// `storageKey` is a stable identifier into the storage layer
/// (src/lib/storage/), never a public URL — access is always brokered
/// through a request that verifies Submission ownership first.
model AnswerSheetPage {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  /// 1-based position within this submission's answer sheet. Explicit and
  /// database-enforced (see @@unique below) rather than inferred from
  /// upload time or array position, so page order is never ambiguous.
  pageNumber Int

  /// Server-generated storage identifier (see
  /// src/lib/storage/answerSheets.ts for the exact convention) — never
  /// derived from the original filename and never a public URL.
  storageKey String @unique

  /// The filename the browser reported, kept only as display metadata —
  /// never used to derive the storage path or trusted for content type.
  originalFilename String

  /// Sniffed from the file's actual bytes at upload time, not the browser's
  /// declared Content-Type. One of image/jpeg, image/png, image/webp.
  mimeType String

  fileSizeBytes Int

  /// Storage key of the teacher-style marked-up copy of this page (ticks,
  /// per-question scores, circled mistakes) produced by the Mathematics
  /// correction flow. Null until that flow has run and successfully annotated
  /// this page — annotation is best-effort, so a page that could not be
  /// marked up simply keeps this null and is shown unannotated.
  ///
  /// A separate key rather than overwriting `storageKey`: the student's
  /// original submitted page must remain retrievable and unmodified.
  annotatedStorageKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A page number can exist at most once per submission — the structural
  /// guarantee against duplicate/conflicting pages.
  @@unique([submissionId, pageNumber])
}

// ---------------------------------------------------------------------------
// SubmissionProcessing (Phase 3.4A/3.4B — handwritten submission processing)
// ---------------------------------------------------------------------------

enum SubmissionProcessingStatus {
  /// Created, not yet claimed by a processing run.
  PENDING
  /// Deterministic validation, the AI validation gate, and global answer
  /// reading are currently running.
  PROCESSING
  /// Processing completed and produced a structured answer index — ready
  /// for Phase 3.4C evaluation. This does NOT mean the submission was
  /// judged a clean answer sheet; see validationResult.decision, which may
  /// still be "UNCERTAIN" even when this status is READY.
  READY
  /// The AI validation gate concluded this is clearly not a usable answer
  /// sheet (e.g. blank pages, an unrelated document). No answer index was
  /// built. This is a conclusion about the submission, not a bug.
  INVALID
  /// A technical failure (storage read failure, AI provider failure after
  /// retries, malformed AI output that failed structural validation) —
  /// distinct from INVALID. Retriable.
  FAILED
}

/// Tracks the Phase 3.4A/3.4B handwritten-submission processing pipeline for
/// one Submission: deterministic validation, the AI answer-sheet validation
/// gate, and global handwriting reading. Deliberately independent of
/// QuestionResponse and the existing evaluation pipeline — this model only
/// prepares structured, teacher-reviewable input for a LATER evaluation
/// phase (Phase 3.4C) and never itself decides a mark, runs correction, or
/// creates QuestionResponse rows.
///
/// One-to-one with Submission (@unique submissionId): a submission is
/// uploaded and submitted exactly once in the current architecture (pages
/// can only be added/removed while the submission is still DRAFT — see
/// isAnswerSheetEditableStatus), so there is only ever one processing
/// attempt to track per submission. A retry after FAILED updates this same
/// row rather than creating a new one.
model SubmissionProcessing {
  id           String     @id @default(cuid())
  submissionId String     @unique
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  status SubmissionProcessingStatus @default(PENDING)

  /// The AI validation gate's structured decision + evidence (see
  /// src/lib/handwritten/types.ts for the exact shape) — always present
  /// once a processing attempt has actually run, including for INVALID and
  /// UNCERTAIN outcomes. Never a raw, unstructured model response.
  validationResult Json?

  /// The structured global answer index (see
  /// src/lib/handwritten/types.ts) — mapped answers, unmapped content, and
  /// per-question coverage. Null while PENDING/PROCESSING, and intentionally
  /// left null (not fabricated) when the validation gate concluded INVALID.
  answerIndex Json?

  /// Set only when status is FAILED — a short, plain-language reason,
  /// never a raw stack trace or provider error body.
  processingError String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum QuestionResponseStatus {
  PENDING
  ANSWER_EXTRACTED
  CORRECTING
  CORRECTED
  ANNOTATING
  ANNOTATED
  GRADING
  GRADED
  NEEDS_REVIEW
  FAILED
}

/// One student's response to one question within one submission. This is
/// the unit the Assessment Brain pipeline processes independently, and the
/// row historical evaluations must be reproducible from — hence the
/// (nullable, filled in once correction runs) pointer to the exact
/// RubricVersion used, rather than a pointer to the mutable Rubric.
///
/// Pipeline outputs (extracted answer, correction/annotation/grading
/// results) are stored as JSON for now rather than normalized tables, since
/// their shape is still evolving and doesn't yet need relational querying.
model QuestionResponse {
  id           String                 @id @default(cuid())
  submissionId String
  submission   Submission             @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  questionId   String
  question     Question               @relation(fields: [questionId], references: [id], onDelete: Restrict)
  status       QuestionResponseStatus @default(PENDING)

  // Future pipeline outputs, per question.
  studentAnswer    Json?
  correctionResult Json?
  annotationResult Json?
  gradingResult    Json?

  /// The exact rubric version this response was (or will be) evaluated
  /// against, so results remain reproducible even after the rubric's active
  /// version later changes. Null until correction has run.
  rubricVersionUsedId String?
  rubricVersionUsed   RubricVersion? @relation(fields: [rubricVersionUsedId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviewItems             ReviewItem[]
  novelApproachCandidates NovelApproachCandidate[]

  @@unique([submissionId, questionId])
  @@index([questionId])
  @@index([status])
  @@index([rubricVersionUsedId])
}

// ---------------------------------------------------------------------------
// ReviewItem
// ---------------------------------------------------------------------------

enum ReviewReason {
  NOVEL_APPROACH
  AMBIGUOUS_EXTRACTION
  UNCERTAIN_CORRECTION
  VERIFICATION_FAILURE
  AMBIGUOUS_ANNOTATION
  UNDETERMINED_GRADING
  /// The Phase 3.4B AI answer-sheet validation gate concluded a handwritten
  /// submission's uploaded pages are not usable as a genuine answer sheet
  /// (e.g. an unrelated document, all pages blank). Submission-scoped only
  /// — never tied to a specific Question or QuestionResponse, since no
  /// evaluation was attempted.
  INVALID_ANSWER_SHEET
  OTHER
}

enum ReviewItemStatus {
  PENDING
  IN_REVIEW
  RESOLVED
  DISMISSED
}

/// A generic unresolved case surfaced by the pipeline for teacher review.
/// All entity relationships are optional and independent (SetNull on
/// delete) because a ReviewItem is metadata *about* other records, not an
/// owned child of any single one of them — e.g. a review item can be scoped
/// to a whole assessment (no specific submission yet) or to one exact
/// question response, without forcing the unused foreign keys to be
/// populated with meaningless values.
model ReviewItem {
  id     String           @id @default(cuid())
  reason ReviewReason
  status ReviewItemStatus @default(PENDING)

  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  questionId String?
  question   Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  questionResponseId String?
  questionResponse   QuestionResponse? @relation(fields: [questionResponseId], references: [id], onDelete: SetNull)

  /// Snapshot of whatever context led to this review case (e.g. candidate
  /// extraction options, conflicting correction signals). Shape varies by
  /// reason, hence JSON.
  context Json?

  reviewerId String?
  reviewer   User?   @relation("ReviewItemReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  decision   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([reason])
}

// ---------------------------------------------------------------------------
// NovelApproachCandidate
// ---------------------------------------------------------------------------

enum NovelApproachStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  ACTIVATED
}

/// A verified student approach that may eventually be folded into a future
/// RubricVersion. Deliberately a separate, review-gated table rather than a
/// direct edit to RubricVersion content: a candidate must never silently
/// change an existing (especially ACTIVE) rubric version — it only becomes
/// part of the rubric once explicitly approved and activated, at which
/// point that action creates a new RubricVersion.
model NovelApproachCandidate {
  id     String              @id @default(cuid())
  status NovelApproachStatus @default(PENDING_REVIEW)

  questionResponseId String
  questionResponse   QuestionResponse @relation(fields: [questionResponseId], references: [id], onDelete: Cascade)

  /// The rubric version this approach was found to fall outside of.
  rubricVersionId String
  rubricVersion   RubricVersion @relation(fields: [rubricVersionId], references: [id], onDelete: Restrict)

  approachData Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([rubricVersionId])
}

// ---------------------------------------------------------------------------
// AiCallLog
// ---------------------------------------------------------------------------

/// One row per completed callStructuredAi/callStructuredAiWithContent call
/// (src/lib/ai/callStructured.ts) — the only two functions that ever talk to
/// OpenRouter. Exists purely for cost observability: never read by the
/// pipeline itself, and a failure to write one must never fail the AI call
/// it's describing (see callStructured.ts's try/catch around the insert).
model AiCallLog {
  id String @id @default(cuid())

  /// OpenRouter model slug (e.g. "openai/gpt-5.6-luna"), not a foreign key —
  /// models are plain string constants (src/lib/ai/models.ts), not a table.
  model String

  /// The calling stage's own label (e.g. "RUBRIC_GENERATION",
  /// "ANSWER_READING_AI") — whatever it passed as `stage` in its call
  /// options. Free-form rather than an enum since new AI-assisted stages are
  /// added often and each needs no schema change to become attributable.
  stage String

  promptTokens     Int
  completionTokens Int
  /// Computed from promptTokens/completionTokens against the pricing table
  /// (src/lib/ai/pricing.ts) at call time — not recomputed later, so a rate
  /// change never rewrites the historical cost of a past call.
  costUsd          Decimal @db.Decimal(10, 6)

  /// Caller-supplied identifiers (questionId, questionResponseId,
  /// submissionId, etc.) — shape varies by stage, same pattern as
  /// ReviewItem.context. Nullable: not every call site has one available.
  context Json?

  createdAt DateTime @default(now())

  @@index([stage])
  @@index([model])
  @@index([createdAt])
}
