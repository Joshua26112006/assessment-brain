# PostgreSQL connection string used by Prisma.
# Copy this file to .env and fill in real values for your environment.
# Do not commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/assessment_brain?schema=public"

# Auth.js signing secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-generated-secret"
